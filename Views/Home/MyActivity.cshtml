@model IEnumerable<StudentProjectPapers.Models.StudentDocument>

@{
    ViewData["Title"] = "My Activity";
    Layout = "_UserLayout";
}

<style>
    .activity-header {
        background: #081547;
        border-radius: 14px;
        padding: 1.5rem 2rem;
        color: #fff;
        margin-bottom: 1.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .activity-header h4 {
            font-family: "Poppins", sans-serif;
            font-weight: 700;
            margin: 0 0 0.25rem;
        }

        .activity-header p {
            opacity: 0.85;
            margin: 0;
            font-size: 0.9rem;
        }

        .activity-header i {
            font-size: 3rem;
            opacity: 0.2;
        }

    .activity-title {
        color: #3A2DC4;
        font-weight: 700;
    }

    .doc-type-badge {
        display: inline-block;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #6B7180;
        margin-bottom: 0.4rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.3rem 0.75rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .status-Pending {
        background: #fef3c7;
        color: #92400e;
    }

    .status-Verified {
        background: #d1fae5;
        color: #065f46;
    }

    .status-Rejected {
        background: #fee2e2;
        color: #991b1b;
    }

    .rejection-note {
        background: #FEE2E2;
        border-radius: 8px;
        padding: 0.6rem 0.8rem;
        font-size: 0.82rem;
        color: #991b1b;
        margin-top: 0.6rem;
    }

    .activity-card .card-footer {
        border-top: none;
        display: flex;
        gap: 0.5rem;
        padding-bottom: 1rem;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
    }

    .empty-icon {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(58,45,196,0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.25rem;
    }

        .empty-icon i {
            font-size: 2rem;
            color: #081547;
        }

    .btn-download {
        background:#FF2D8D ;
        border-color: #FF2D8D;
        color: #fff;
        font-weight: 600;
    }

    .btn-download:hover {
        background:#0B1F66;
        border-color: #0B1F66;
        color: #fff;
    }
    .btn-primary{
        background-color:#081547;
    }

    .btn-view {
        border-color: #0B1F66 !important;
        color: #0B1F66 !important;
        font-weight: 600;
    }

    .btn-view:hover {
        background:#0B1F66 !important;
        border-color: #0B1F66 !important;
        color: white !important;
    }
</style>

<div class="activity-header">
    <div>
        <h4>My Activity</h4>
        <p>All your uploaded intern reports, attendance reports, and letters</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-inbox"></i>
            </div>
            <h5 style="font-family:'Poppins',sans-serif;font-weight:700;color:#1F2333;">
                No activity yet
            </h5>
            <p class="text-muted mb-3">
                You haven't uploaded anything yet. Start by submitting a document.
            </p>
            <a href="@Url.Action("InternReport", "Home")" class="btn btn-primary">
                <i class="fas fa-cloud-arrow-up"></i> Upload Document
            </a>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var doc in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 activity-card">
                    <div class="card-body">
                        <span class="doc-type-badge">
                            @(doc.DocumentType == StudentProjectPapers.Models.DocumentType.InternReport ? "Intern Report" :
                              doc.DocumentType == StudentProjectPapers.Models.DocumentType.AttendanceReport ? "Attendance Report" : "Internship Letter")
                        </span>
                        <h5 class="card-title activity-title">@doc.Title</h5>
                        <hr />
                        <p class="card-text">
                            <strong><i class="fas fa-building"></i> Company:</strong> @doc.CompanyName<br />
                            <strong><i class="fas fa-calendar-alt"></i> Year:</strong> @doc.Year<br />
                            <strong><i class="fas fa-clock"></i> Uploaded:</strong> @doc.UploadedDate.ToString("MMMM dd, yyyy")
                        </p>

                        <span class="status-badge status-@doc.Status">
                            @if (doc.Status == StudentProjectPapers.Models.DocumentStatus.Pending)
                            {
                                <i class="fas fa-hourglass-half"></i><text> Pending Review</text>
                            }
                            else if (doc.Status == StudentProjectPapers.Models.DocumentStatus.Verified)
                            {
                                <i class="fas fa-check-circle"></i><text> Verified</text>
                            }
                            else
                            {
                                <i class="fas fa-times-circle"></i><text> Rejected</text>
                            }
                        </span>

                        @if (doc.Status == StudentProjectPapers.Models.DocumentStatus.Rejected && !string.IsNullOrEmpty(doc.RejectionReason))
                        {
                            <div class="rejection-note">
                                <strong>Reason:</strong> @doc.RejectionReason
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-transparent">
                        <a href="@Url.Action("ViewDocument", "Home", new { id = doc.Id })"
                           target="_blank" class="btn btn-outline-primary btn-view btn-sm flex-fill">
                            <i class="fas fa-eye"></i> View
                        </a>
                        <a href="@Url.Action("DownloadDocument", "Home", new { id = doc.Id })"
                           class="btn btn-download btn-sm flex-fill">
                            <i class="fas fa-download"></i> Download
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
