@{
    ViewData["Title"] = "BIT Dashboard";
}

<!-- Stats Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card bg-primary text-white shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Total Projects</h6>
                        <h2 class="mb-0">@ViewBag.TotalProjects</h2>
                    </div>
                    <i class="fas fa-file-alt fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-warning text-white shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Pending Approvals</h6>
                        <h2 class="mb-0" id="pendingApprovalsCount">@ViewBag.PendingUsers</h2>
                    </div>
                    <i class="fas fa-user-clock fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-success text-white shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Approved Users</h6>
                        <h2 class="mb-0">@ViewBag.ApprovedUsers</h2>
                    </div>
                    <i class="fas fa-user-check fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-info text-white shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0">Total Users</h6>
                        <h2 class="mb-0">@ViewBag.TotalUsers</h2>
                    </div>
                    <i class="fas fa-users fa-2x opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0"><i class="fas fa-bolt"></i> Quick Actions</h5>
            </div>
            <div class="card-body">
                <a href="@Url.Action("UploadProject")" class="btn btn-primary me-2">
                    <i class="fas fa-upload"></i> Upload New Project
                </a>
                <a href="@Url.Action("PendingUsers")" class="btn btn-warning me-2">
                    <i class="fas fa-user-check"></i> Review Pending Users
                </a>
                <a href="@Url.Action("ManageProjects")" class="btn btn-info">
                    <i class="fas fa-tasks"></i> Manage Projects
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Recent Projects -->
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="fas fa-clock"></i> Recent Projects</h5>
    </div>
    <div class="card-body">
        @if (ViewBag.RecentProjects != null && ViewBag.RecentProjects.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Student</th>
                            <th>LCID</th>
                            <th>Submitted Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var project in ViewBag.RecentProjects)
                        {
                            <tr>
                                <td>@project.ProjectTitle</td>
                                <td>@project.StudentName</td>
                                <td>@project.LCID</td>
                                <td>@project.SubmittedDate.ToShortDateString()</td>
                                <td>
                                    <a href="@Url.Action("DownloadProject", "Home", new { id = project.Id })" class="btn btn-sm btn-success">
                                        <i class="fas fa-download"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted">No projects uploaded yet.</p>
        }
    </div>
</div>
