@model StudentProjectPapers.Models.AdminResetPasswordViewModel

@{
    ViewData["Title"] = "Reset User Password";
    Layout = "_AdminLayout";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h4 class="mb-0">
                        <i class="fas fa-key"></i> Reset Password for @Model.UserName
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="ResetUserPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="UserEmail" />
                        <input type="hidden" asp-for="UserName" />

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> Resetting password for: <strong>@Model.UserEmail</strong>
                        </div>

                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Note:</strong> A secure, single-use reset link will be emailed to the user.
                            No password is set, emailed, or logged — the user chooses their own new password.
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="SendEmailNotification" class="form-check-input" />
                            <label asp-for="SendEmailNotification" class="form-check-label"></label>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="MustChangePassword" class="form-check-input" />
                            <label asp-for="MustChangePassword" class="form-check-label">
                                <strong>User must change password at next login</strong>
                            </label>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="@Url.Action("Users")" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i> Send Reset Link
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
