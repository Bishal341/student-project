@model IEnumerable<StudentProjectPapers.Models.UserManagementViewModel>

@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    @Html.AntiForgeryToken()
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users"></i> User Management</h2>
        <div>
            <span class="badge bg-primary me-2">Total: @ViewBag.TotalUsers</span>
            <span class="badge bg-success me-2">Approved: @ViewBag.ApprovedUsers</span>
            <span class="badge bg-warning">Pending: @ViewBag.PendingUsers</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <h5 class="mb-0"><i class="fas fa-list"></i> All Users</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="usersTable" class="table table-hover">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Password Status</th>
                            <th>Registered Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "N/A" : user.PhoneNumber)</td>
                                <td>
                                    <span class="badge bg-info">@user.Role</span>
                                </td>
                                <td>
                                    @if (user.IsApproved)
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                </td>
                                <td>
                                    @if (user.PasswordStatus == "Must Change at Next Login")
                                    {
                                        <span class="badge bg-danger">Must Change</span>
                                    }
                                    else if (user.PasswordStatus == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No Password</span>
                                    }
                                </td>
                                <td>@user.RegisteredDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="@Url.Action("UserDetails", new { id = user.Id })" class="btn btn-sm btn-info" title="View Details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="@Url.Action("ResetUserPassword", new { id = user.Id })" class="btn btn-sm btn-warning" title="Reset Password">
                                            <i class="fas fa-key"></i>
                                        </a>
                                        @if (!user.IsApproved)
                                        {
                                            <button class="btn btn-sm btn-success js-approve-user" data-user-id="@user.Id" title="Approve User">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-danger js-suspend-user" data-user-id="@user.Id" title="Suspend User">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .dataTables_wrapper {
        padding: 10px;
    }
    .btn-group .btn {
        margin: 0 2px;
    }

    #usersTable_wrapper .dataTables_info {
        float: left;
        padding-top: 8px;
    }

    #usersTable_wrapper .dataTables_paginate {
        float: right;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 0;
    }

    #usersTable_wrapper::after {
        content: "";
        display: table;
        clear: both;
    }

    #usersTable_wrapper .dataTables_paginate .paginate_button {
        text-decoration: none !important;
        padding: 6px 14px;
        margin: 0;
        border-radius: 8px;
        border: 1px solid #3A2DC4;
        color: #3A2DC4 !important;
        background: #fff !important;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
    }

    #usersTable_wrapper .dataTables_paginate .paginate_button:hover {
        background: #3A2DC4 !important;
        color: #fff !important;
        border-color: #3A2DC4;
    }

    #usersTable_wrapper .dataTables_paginate .paginate_button.current {
        background: #3A2DC4 !important;
        color: #fff !important;
        border-color: #3A2DC4;
    }

    #usersTable_wrapper .dataTables_paginate .paginate_button.disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    @@media (max-width: 768px) {
    .container-fluid .d-flex.justify-content-between {
        flex-wrap: nowrap;
        gap: 0.5rem;
    }

    .container-fluid h2 {
        font-size: 1.1rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .container-fluid h2 i {
        font-size: 1rem;
    }

    .badge {
        font-size: 0.68rem;
        padding: 0.4em 0.55em;
    }
}
</style>

@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    @{
        var nonce = Context.Items["CspNonce"] as string;
    }
    <script nonce="@nonce">
        $(document).ready(function() {
            $('#usersTable').DataTable({
                "order": [[7, "desc"]],
                "pageLength": 25,
                "language": {
                    "search": "Search:",
                    "lengthMenu": "Show _MENU_ entries",
                    "info": "Showing _START_ to _END_ of _TOTAL_ users",
                    "paginate": {
                        "previous": "<i class='fas fa-chevron-left'></i> Prev",
                        "next": "Next <i class='fas fa-chevron-right'></i>"
                    }
                }
            });
        });

        function approveUser(userId) {
            if (confirm('Approve this user? They will receive an email notification.')) {
                $.ajax({
                    url: '@Url.Action("ToggleUserApproval")',
                    type: 'POST',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    data: { userId: userId, isApproved: true },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    }
                });
            }
        }

        function suspendUser(userId) {
            if (confirm('Suspend this user? They will lose access to the system.')) {
                $.ajax({
                    url: '@Url.Action("ToggleUserApproval")',
                    type: 'POST',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    data: { userId: userId, isApproved: false },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    }
                });
            }
        }

        // Unobtrusive bindings replacing the former inline onclick handlers.
        document.querySelectorAll('.js-approve-user').forEach(function (btn) {
            btn.addEventListener('click', function () {
                approveUser(btn.dataset.userId);
            });
        });
        document.querySelectorAll('.js-suspend-user').forEach(function (btn) {
            btn.addEventListener('click', function () {
                suspendUser(btn.dataset.userId);
            });
        });
    </script>
}
