@model IEnumerable<StudentProjectPapers.Models.ApplicationUser>

@{
    ViewData["Title"] = "Pending Users";
}

<h2>Pending User Approvals</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div id="ajaxAlerts"></div>

@if (!Model.Any())
{
    <div class="alert alert-info">No pending user approvals.</div>
}
else
{
    <div class="table-responsive" id="pendingTable">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Full Name</th>
                    <th>Email</th>
                    <th>Registered Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.RegisteredDate.ToString("MMMM dd, yyyy")</td>
                        <td>
                            <form asp-action="ApproveUser" method="post" style="display: inline;" class="js-approve-form">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="fas fa-check"></i> Approve
                                </button>
                            </form>
                            <form asp-action="RejectUser" method="post" style="display: inline;" class="js-reject-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@user.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="fas fa-times"></i> Reject
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    @{
        var nonce = Context.Items["CspNonce"] as string;
    }
    <script nonce="@nonce">
        function rejectUser(form, e) {
            e.preventDefault();

            if (!confirm('Reject this user? Their account will be permanently deleted and their email freed up for re-registration. This action cannot be undone.')) {
                return false;
            }

            var btn = form.querySelector('button[type="submit"]');
            var userId = form.querySelector('input[name="userId"]').value;
            var token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            var url = form.getAttribute('action');
            var row = $(form).closest('tr');

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Rejecting...';

            $.ajax({
                url: url,
                method: 'POST',
                headers: { 'RequestVerificationToken': token },
                data: { userId: userId }
            })
            .done(function (data) {
                if (data.success) {
                    row.fadeOut(200, function () {
                        row.remove();
                        if ($('#pendingTable table tbody tr').length === 0) {
                            $('#pendingTable').html('<div class="alert alert-info">No pending user approvals.</div>');
                        }
                    });
                    showAjaxAlert('success', data.message);
                    if (typeof fetchPendingCount === 'function') {
                        fetchPendingCount();
                    }
                } else {
                    showAjaxAlert('danger', data.message);
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-times"></i> Reject';
                }
            })
            .fail(function () {
                showAjaxAlert('danger', 'Failed to reject user. Please try again.');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-times"></i> Reject';
            });

            return false;
        }

        function showAjaxAlert(type, message) {
            var alert = $('<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert">' +
                message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            $('#ajaxAlerts').append(alert);
            setTimeout(function () { alert.fadeOut(300, function () { alert.remove(); }); }, 6000);
        }

        // Unobtrusive bindings replacing the former inline onclick/onsubmit handlers.
        document.querySelectorAll('.js-approve-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (!confirm('Approve this user? They will receive an email to set their password.')) {
                    e.preventDefault();
                }
            });
        });
        document.querySelectorAll('.js-reject-form').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                rejectUser(form, e);
            });
        });
    </script>
}