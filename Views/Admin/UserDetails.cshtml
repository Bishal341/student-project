@model StudentProjectPapers.Models.UserDetailsViewModel

@{
    ViewData["Title"] = "User Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-id-card"></i> User Details</h2>
        <a href="@Url.Action("Users")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Users
        </a>
    </div>

    <div class="row">
        <!-- Overview Card -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm text-center">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="fas fa-user-circle fa-5x text-primary"></i>
                    </div>
                    <h4 class="card-title mb-1">@Model.FullName</h4>
                    <p class="text-muted mb-2">@@@Model.UserName</p>
                    <span class="badge bg-info fs-6 mb-3">@Model.Role</span>

                    <div class="d-flex justify-content-center gap-2 mb-2">
                        @if (Model.IsApproved)
                        {
                            <span class="badge bg-success"><i class="fas fa-check-circle"></i> Approved</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark"><i class="fas fa-clock"></i> Pending Approval</span>
                        }

                        @if (Model.LockoutEnd.HasValue && Model.LockoutEnd > DateTimeOffset.UtcNow)
                        {
                            <span class="badge bg-danger"><i class="fas fa-lock"></i> Locked Out</span>
                        }
                        else
                        {
                            <span class="badge bg-success"><i class="fas fa-unlock"></i> Active</span>
                        }
                    </div>

                    <hr />

                    <div class="d-grid gap-2">
                        <a href="@Url.Action("ResetUserPassword", new { id = Model.Id })" class="btn btn-warning">
                            <i class="fas fa-key"></i> Reset Password
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Details Card -->
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Account Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">User ID</dt>
                        <dd class="col-sm-8"><code class="user-select-all">@Model.Id</code></dd>

                        <dt class="col-sm-4 text-muted">Email Address</dt>
                        <dd class="col-sm-8">
                            @Model.Email
                            @if (Model.EmailConfirmed)
                            {
                                <span class="badge bg-success ms-1"><i class="fas fa-check"></i> Verified</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary ms-1">Unverified</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Phone Number</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrEmpty(Model.PhoneNumber) ? "N/A" : Model.PhoneNumber)
                            @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                            {
                                if (Model.PhoneNumberConfirmed)
                                {
                                    <span class="badge bg-success ms-1"><i class="fas fa-check"></i> Verified</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary ms-1">Unverified</span>
                                }
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Registered Date</dt>
                        <dd class="col-sm-8">@Model.RegisteredDate.ToString("MMMM dd, yyyy HH:mm")</dd>

                        <dt class="col-sm-4 text-muted">Approved Date</dt>
                        <dd class="col-sm-8">
                            @(Model.ApprovedDate.HasValue ? Model.ApprovedDate.Value.ToString("MMMM dd, yyyy HH:mm") : "Not Approved Yet")
                        </dd>

                        <dt class="col-sm-4 text-muted">Password Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.PasswordStatus == "Must Change at Next Login" || Model.MustChangePassword)
                            {
                                <span class="badge bg-danger">Must Change at Next Login</span>
                            }
                            else if (Model.PasswordStatus == "Active")
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Model.PasswordStatus</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Two-Factor Auth</dt>
                        <dd class="col-sm-8">
                            @if (Model.TwoFactorEnabled)
                            {
                                <span class="badge bg-success">Enabled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Disabled</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-muted">Failed Login Attempts</dt>
                        <dd class="col-sm-8">@Model.AccessFailedCount</dd>

                        <dt class="col-sm-4 text-muted">Lockout Expiration</dt>
                        <dd class="col-sm-8">
                            @(Model.LockoutEnd.HasValue ? Model.LockoutEnd.Value.ToString("MMMM dd, yyyy HH:mm zzz") : "None")
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
